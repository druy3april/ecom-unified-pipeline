.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Power BI temp files (nếu có sinh file backup/temp)
*.tmp